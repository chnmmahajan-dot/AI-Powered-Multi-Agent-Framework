
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discovered Website Workflows",
  "type": "object",
  "required": ["workflows"],
  "additionalProperties": false,
  "properties": {
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "workflow_id",
          "title",
          "description",
          "steps",
          "elements_used",
          "expected_outcome"
        ],
        "additionalProperties": false,
        "properties": {
          "workflow_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "elements_used": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "expected_outcome": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
