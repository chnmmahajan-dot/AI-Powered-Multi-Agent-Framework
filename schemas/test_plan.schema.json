
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Generated Test Plan",
  "description": "Defines the structure of a test plan generated by the AI test design agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "test_case_id",
    "title",
    "steps"
  ],
  "properties": {
    "test_case_id": {
      "type": "string",
      "minLength": 1
    },
    "requirement_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "expected_result": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "navigate",
              "click",
              "fill",
              "press",
              "select_option",
              "check",
              "uncheck",
              "verify_text",
              "verify_visible",
              "verify_url",
              "wait_for"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "by",
              "value"
            ],
            "properties": {
              "by": {
                "type": "string",
                "enum": [
                  "role",
                  "label",
                  "placeholder",
                  "text",
                  "test_id",
                  "css"
                ]
              },
              "role": {
                "type": "string"
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "exact": {
                "type": "boolean"
              }
            }
          },
          "value": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000
          }
        }
      }
    }
  }
}
